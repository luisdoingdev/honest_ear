DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,web

POSTGRES_DB=honestear
POSTGRES_USER=honestear
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://honestear:change-me@db:5432/honestear

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Speech: the Whisper (transcriber) and wav2vec2 (scorer) containers. Without them, recordings still work.
# SCORER_SECRET is shared by Django and both containers; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCORER_SECRET=
SCORER_URL=http://scorer:8000/
SCORER_TIMEOUT_SECONDS=30
TRANSCRIBER_URL=http://transcriber:8000/
