# Copied to .env by ./start.sh (SECRET_KEY is generated). Never commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=honest-ear.localhost,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://honest-ear.localhost

# Host ports for nginx. If HTTPS_PORT isn't 443, add the port to CSRF_TRUSTED_ORIGINS
# (e.g. https://honest-ear.localhost:8443).
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=honest_ear
POSTGRES_USER=honest_ear
POSTGRES_PASSWORD=honest_ear
DATABASE_URL=postgres://honest_ear:honest_ear@db:5432/honest_ear

REDIS_URL=redis://redis:6379
EMAIL_URL=smtp://mailpit:1025

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@honest-ear.localhost
DJANGO_SUPERUSER_PASSWORD=admin

# Poll for file changes. Needed when the Docker file share doesn't forward change events
# (e.g. Rancher Desktop with reverse-sshfs). Set false on Docker Desktop/virtiofs to save CPU.
WATCHFILES_FORCE_POLLING=true

# Number of web (uvicorn) containers nginx load-balances across.
WEB_REPLICAS=2
