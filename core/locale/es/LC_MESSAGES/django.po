#: consumers.py:93
msgid "Something went wrong with this recording."
msgstr "Algo salió mal con esta grabación."

#: consumers.py:98
msgid "No audio was recorded."
msgstr "No se grabó ningún audio."

#: consumers.py:142
msgid "Couldn't transcribe this recording."
msgstr "No se pudo transcribir esta grabación."

#: templates/core/record.html:23
msgid "Start a session to record your voice."
msgstr "Empieza una sesión para grabar tu voz."

#: templates/core/record.html:25
msgid "Recording is unavailable right now. Please check back soon."
msgstr ""
"La grabación no está disponible en este momento. Vuelve a intentarlo pronto."

#: templates/core/record.html:32
msgid "Phonemes"
msgstr "Fonemas"

#: templates/core/record.html:35
msgid ""
"Top: the sounds the words should have. Bottom: what was heard. Highlighted: "
"changed, missing (–) or extra."
msgstr ""
"Arriba: los sonidos que deberían tener las palabras. Abajo: lo que se oyó. "
"Resaltado: cambiado, faltante (–) o de más."

#: templates/core/record.html:41
msgid "Play"
msgstr "Reproducir"

#  "Iniciar sesión" would read as "Log in", so this says "Begin".
#: templates/core/record.html:45
msgid "Start session"
msgstr "Empezar"
