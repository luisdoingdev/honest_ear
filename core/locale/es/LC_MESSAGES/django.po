#: templates/core/record.html:21
msgid "Start a session to record your voice."
msgstr "Empieza una sesión para grabar tu voz."

#  "Iniciar sesión" would read as "Log in", so this says "Begin".
#: templates/core/record.html:24
msgid "Start session"
msgstr "Empezar"

#: templates/core/record.html:25
msgid "Record"
msgstr "Grabar"

#: templates/core/record.html:26
msgid "Stop"
msgstr "Detener"

#: templates/core/record.html:27
msgid "Play"
msgstr "Reproducir"

#: templates/core/record.html:30
msgid "Recording is unavailable right now. Please check back soon."
msgstr ""
"La grabación no está disponible en este momento. Vuelve a intentarlo pronto."

#: templates/core/record.html:33
msgid "Language"
msgstr "Idioma"

#: views.py:30
msgid "Recording is turned off right now."
msgstr "La grabación está desactivada en este momento."

#: views.py:35
msgid "No audio was uploaded."
msgstr "No se subió ningún audio."

#: views.py:40
#, python-format
msgid "Unsupported audio type: %(type)s"
msgstr "Tipo de audio no compatible: %(type)s"

#: views.py:44
msgid "Recording is too large (5 MB max)."
msgstr "La grabación es demasiado grande (máximo 5 MB)."
