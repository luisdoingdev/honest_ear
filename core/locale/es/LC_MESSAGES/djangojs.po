#: static/core/record.js:36
msgid "Start session"
msgstr "Empezar"

#: static/core/record.js:36
msgid "Stop"
msgstr "Detener"

#: static/core/record.js:37
msgid "Record again"
msgstr "Grabar otra vez"

#: static/core/record.js:57
#, javascript-format
msgid "Listening… %s"
msgstr "Escuchando… %s"

#: static/core/record.js:83
msgid "No speech detected."
msgstr "No se detectó voz."

#: static/core/record.js:185
msgid ""
"Microphone access was denied. Allow it in your browser settings and try "
"again."
msgstr ""
"No se permitió el acceso al micrófono. Actívalo en la configuración del "
"navegador y vuelve a intentarlo."

#: static/core/record.js:210
msgid "Transcribing…"
msgstr "Transcribiendo…"

#: static/core/record.js:242
msgid "Tap Play to hear it. It's deleted when it finishes."
msgstr "Toca Reproducir para escucharla. Se borra cuando termina."

#: static/core/record.js:246
#, javascript-format
msgid "Upload failed: %s"
msgstr "No se pudo subir: %s"

#: static/core/record.js:252
msgid "Recording needs a secure connection. Open this page over HTTPS."
msgstr ""
"Para grabar se necesita una conexión segura. Abre esta página con HTTPS."

#: static/core/record.js:258
msgid "This browser can't record audio. Try a recent Chrome or Safari."
msgstr ""
"Este navegador no puede grabar audio. Prueba con una versión reciente de "
"Chrome o Safari."

#: static/core/record.js:270
msgid "Playing…"
msgstr "Reproduciendo…"

#: static/core/record.js:272
msgid "Couldn't play the recording."
msgstr "No se pudo reproducir la grabación."

#: static/core/record.js:284
msgid "Kept for evaluation. Tap the mic to record again."
msgstr "Se guardó para evaluación. Toca el micrófono para grabar otra vez."

#: static/core/record.js:285
msgid "Deleted. Tap the mic to record again."
msgstr "Borrada. Toca el micrófono para grabar otra vez."

#: static/core/record.js:288
msgid "Played, but deleting failed. It will be removed automatically."
msgstr "Se reprodujo, pero no se pudo borrar. Se eliminará automáticamente."
