# Local speech-to-text (scorer/transcriber.py): faster-whisper on CPU, for the eval bench and tests.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/cache

WORKDIR /app
# faster-whisper decodes WebM/Opus and MP4/AAC itself (PyAV bundles ffmpeg's libraries).
COPY requirements-transcriber.txt .
RUN pip install -r requirements-transcriber.txt

COPY engine.py transcriber.py ./

# The model cache is a volume, so the weights download once, not on every start.
RUN useradd --create-home transcriber && mkdir -p /cache && chown transcriber /cache
USER transcriber

EXPOSE 8000
CMD ["uvicorn", "transcriber:app", "--host", "0.0.0.0", "--port", "8000"]
